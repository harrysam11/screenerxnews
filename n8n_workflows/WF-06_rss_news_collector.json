{
  "name": "WF-06: RSS & News Collector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "schedule-trigger-10m",
      "name": "Schedule Trigger (10m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
        "options": {}
      },
      "id": "rss-coindesk",
      "name": "CoinDesk RSS Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst newsItems = [];\nfor (const item of items) {\n  newsItems.push({\n    json: {\n      source_name: 'coindesk',\n      title: item.json.title || 'Breaking Crypto News',\n      url: item.json.link || 'https://coindesk.com',\n      published_at: item.json.pubDate || new Date().toISOString(),\n      sentiment_score: 0.2\n    }\n  });\n}\nreturn newsItems;"
      },
      "id": "format-news",
      "name": "Format News Payloads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/v1/news/feed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "post-news-feed",
      "name": "Post to FastAPI News Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [860, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (10m)": {
      "main": [
        [
          {
            "node": "CoinDesk RSS Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CoinDesk RSS Feed": {
      "main": [
        [
          {
            "node": "Format News Payloads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format News Payloads": {
      "main": [
        [
          {
            "node": "Post to FastAPI News Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
