# ==============================================================================
# Solana Memecoin Intelligence, Forensics & Trading OS - Environment Config
# ==============================================================================

# Database Configuration (SQLite-first default; PostgreSQL optional)
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///./data/memecoin_os.db
# Optional PostgreSQL:
# DATABASE_BACKEND=postgresql
# DATABASE_URL=postgresql+asyncpg://memecoin_user:memecoin_secure_pass@localhost:5432/memecoin_os

# Optional Heavy Component Toggles (all false by default for lightweight/Termux mode)
ENABLE_WINDMILL=false
ENABLE_N8N=false
ENABLE_HERMES=false
ENABLE_LOCAL_AI=false
ENABLE_DOCKER=false
ENABLE_REDIS=false

# Application Core
APP_ENV=development
APP_PORT=8000
DEBUG=true
SECRET_KEY=super_secret_local_dev_token_for_fastapi_sessions_only
ADMIN_API_TOKEN=
PROVENANCE_COLLECTOR_SECRET=

# Blockchain RPC Settings (Solana Public Shared Endpoint by default)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# External Free / Permitted APIs
DEX_SCREENER_API_BASE=https://api.dexscreener.com
GOPLUS_API_BASE=https://api.gopluslabs.io
RUGCHECK_API_BASE=https://api.rugcheck.xyz
JUPITER_QUOTE_API_BASE=https://quote-api.jup.ag/v6

# Execution Invariants & Wallet Boundaries
# HARD SAFETY: Server never accepts or processes private keys
ALLOW_LIVE_TRADING=false
COLD_VAULT_ADDRESSES=["ColdVault11111111111111111111111111111111111"]
BURNER_WALLET_ADDRESSES=["BurnerWallet1111111111111111111111111111111"]

# Risk Limits (Hard caps for paper and future approval generation)
MAX_TRADE_SOL=0.5
MAX_DAILY_LOSS_SOL=2.0
MAX_SLIPPAGE_BPS=250
MAX_PRICE_IMPACT_BPS=300

# Telegram Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# n8n Orchestration Secrets
N8N_USER=admin
N8N_PASSWORD=changeme_n8n_pass
N8N_ENCRYPTION_KEY=replace_with_32_characters_random_key
